# StudyPilot AI Backend Environment Configuration Example
APP_NAME="StudyPilot AI"
APP_VERSION="0.3.0"
DEBUG=true
ENVIRONMENT="development"

# Database Configuration (Neon PostgreSQL or Local PostgreSQL)
# For Neon Pooled Connection (normal application traffic):
# DATABASE_URL="postgresql://<user>:<password>@ep-<project>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
# For Neon Direct Connection for Alembic DDL migrations (optional, auto-unpooled if omitted):
# DIRECT_DATABASE_URL="postgresql://<user>:<password>@ep-<project>.<region>.aws.neon.tech/<dbname>?sslmode=require"
#
# For Local PostgreSQL:
DATABASE_URL="postgresql+asyncpg://postgres:admin@localhost:5432/studypilot"
# DIRECT_DATABASE_URL=""

# Authentication & Security
SECRET_KEY="generate-a-strong-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
COOKIE_NAME="studypilot_token"
CSRF_COOKIE_NAME="studypilot_csrf"

# Allowed CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:3002","http://127.0.0.1:3002","http://localhost:8001","http://127.0.0.1:8001"]

# AI Model Provider ("gemini" | "deterministic" | "openai")
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_RATE_LIMIT_PER_MINUTE=20

# RAG & Embedding Service Configuration
EMBEDDING_PROVIDER="gemini"  # "gemini" | "mock"
EMBEDDING_MODEL="models/text-embedding-004"
EMBEDDING_DIMENSION=768
DOCUMENT_STORAGE_DIR="storage/documents"
MAX_DOCUMENT_SIZE_BYTES=15728640  # 15 MB
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_DEFAULT_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.70

# CodeLab Execution Engine (Public CE Sandbox: https://ce.judge0.com)
JUDGE0_API_URL="https://ce.judge0.com"
JUDGE0_API_HOST="ce.judge0.com"
JUDGE0_API_KEY=""
